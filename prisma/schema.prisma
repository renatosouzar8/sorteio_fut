generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Jogador {
  id                Int      @id @default(autoincrement())
  nome              String
  nivel             Int      @default(5)
  posicaoPrimaria   String   @default("meia")
  posicaoSecundaria String?
  isGoleiroDestaque Boolean  @default(false)
  isJogadorProblema Boolean  @default(false)
  confirmado        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
